model 'Admin Monitoring Historical Analytics'
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling"]

ref table 'Usage Activity'
ref table Date
ref table Workspaces
ref table Items
ref table Users
ref table Capacities
ref table 'Governance Items'
ref table 'Sharing Items'
ref table 'Sensitivity Labels'
ref table 'Dormancy Window'
