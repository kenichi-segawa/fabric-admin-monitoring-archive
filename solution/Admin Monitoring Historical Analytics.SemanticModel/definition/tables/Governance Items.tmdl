/// Current and historical governance attributes for Fabric items from the OneLake Governance managed model.
table 'Governance Items'
	lineageTag: 5e7477a9-ba0b-423a-8402-a97371e63720

	/// Current governed item count.
	measure 'Governance Items' =
			CALCULATE(
			    DISTINCTCOUNT('Governance Items'[Item ID]),
			    KEEPFILTERS('Governance Items'[Current Item] = TRUE())
			)
		formatString: #,##0
		displayFolder: Coverage
		lineageTag: bc310c79-f9a7-41f3-b76d-43511a7e4d02

	/// Current governed items with a sensitivity label identifier.
	measure 'Labeled Items' =
			CALCULATE(
			    [Governance Items],
			    KEEPFILTERS(NOT ISBLANK('Governance Items'[Sensitivity Label ID]))
			)
		formatString: #,##0
		displayFolder: Coverage
		lineageTag: d791f64c-2a21-4d00-94ef-aeb55ed10fd6

	/// Share of current governed items with a sensitivity label.
	measure 'Label Coverage %' = DIVIDE([Labeled Items], [Governance Items])
		formatString: 0.0%
		displayFolder: Coverage
		lineageTag: 0d2c3aa1-1d96-44d5-b21c-3f35e0b34c9f

	/// Current governed items with a non-empty, non-None endorsement status.
	measure 'Endorsed Items' =
			CALCULATE(
			    [Governance Items],
			    KEEPFILTERS(NOT ISBLANK('Governance Items'[Endorsement])),
			    KEEPFILTERS('Governance Items'[Endorsement] <> "None")
			)
		formatString: #,##0
		displayFolder: Coverage
		lineageTag: c2608c41-3f8e-4f1f-88ad-91f724e36c90

	/// Share of current governed items that are endorsed.
	measure 'Endorsement Coverage %' = DIVIDE([Endorsed Items], [Governance Items])
		formatString: 0.0%
		displayFolder: Coverage
		lineageTag: fcac97f5-9d50-4e1a-8ee9-b3ba6dc168ce

	/// Current governed items assigned to a domain.
	measure 'Domain Assigned Items' =
			CALCULATE(
			    [Governance Items],
			    KEEPFILTERS(NOT ISBLANK('Governance Items'[Domain ID]))
			)
		formatString: #,##0
		displayFolder: Coverage
		lineageTag: 96d99d48-0b27-4ea1-be2d-f81781d37605

	/// Share of current governed items assigned to a domain.
	measure 'Domain Assignment %' = DIVIDE([Domain Assigned Items], [Governance Items])
		formatString: 0.0%
		displayFolder: Coverage
		lineageTag: 4e923445-685f-4b96-9ce2-fab3d2352e2d

	/// Stable Fabric item identifier.
	column 'Item ID'
		dataType: string
		isHidden
		lineageTag: 63fb12af-c2c2-45c6-aba8-d17666064de0
		summarizeBy: none
		sourceColumn: item_id

	/// Display name of the governed item.
	column 'Item Name'
		dataType: string
		lineageTag: 51699050-18d9-45f4-ac7d-4d91838473da
		sourceColumn: item_name

	/// Fabric item type.
	column 'Item Type'
		dataType: string
		lineageTag: 9edb9672-403e-4931-a7d9-e51f2a2207f2
		sourceColumn: item_type

	/// More specific item subtype when available.
	column 'Item Subtype'
		dataType: string
		lineageTag: 81f0078f-e769-4c5e-9af8-36a696c60d07
		sourceColumn: item_sub_type

	/// Workspace containing the item.
	column 'Workspace ID'
		dataType: string
		isHidden
		lineageTag: 969f0973-81d5-48e5-87a7-fd295d27062b
		summarizeBy: none
		sourceColumn: workspace_id

	/// Number of users with direct access.
	column 'User Access Count'
		dataType: int64
		lineageTag: d88f8ed8-05cc-4b66-acc2-271d403e18f3
		summarizeBy: none
		sourceColumn: user_access_count

	/// Number of groups with access.
	column 'Group Access Count'
		dataType: int64
		lineageTag: e5170e23-4c47-4690-913f-40fe41b0e724
		summarizeBy: none
		sourceColumn: group_access_count

	/// Certification or promotion status.
	column Endorsement
		dataType: string
		lineageTag: 1acb10ad-1b69-4091-8c69-7ef685980fbf
		sourceColumn: endorsement

	/// Whether the item is shared with the entire organization.
	column 'Shared With Whole Organization'
		dataType: string
		lineageTag: ccba5549-eec4-4227-80c1-b1479d30acba
		sourceColumn: is_shared_with_whole_org

	/// Whether a data loss prevention violation is reported.
	column 'DLP Policy Violation'
		dataType: string
		lineageTag: bd588ad7-4bbb-4ee0-b480-e849a40f93db
		sourceColumn: dlp_policy_violation

	/// Whether a sensitivity label is applied.
	column Labeled
		dataType: string
		lineageTag: 4d9f0f66-8b99-40cd-9441-f6c6c2a556b6
		sourceColumn: labeled

	/// Whether the item has a description.
	column Described
		dataType: string
		lineageTag: 4f644512-d291-4ff6-b8ed-78e96831a251
		sourceColumn: described

	/// Managed-model activity classification.
	column 'Activity Status'
		dataType: string
		lineageTag: d24832c3-c6b5-4664-aca7-b91f16219b1d
		sourceColumn: activity_status

	/// Date the item was created.
	column 'Created Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: f4d647d1-dac9-4a37-b7bb-8b14e5dfacb8
		sourceColumn: created_date

	/// Most recent item modification date.
	column 'Modified Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: d6da5967-346e-4910-a6ba-06b1b96111ba
		sourceColumn: modified_date

	/// Most recent observed access date.
	column 'Last Access Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: bf3630f8-7607-48a3-8989-568749545698
		sourceColumn: last_access_date

	/// Most recent refresh date.
	column 'Last Refresh Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: decb1de4-55ac-40e9-9a56-36f2da9ca3bd
		sourceColumn: last_refresh_date

	/// Most recent refresh outcome.
	column 'Last Refresh Status'
		dataType: string
		lineageTag: e05978bb-ac3c-4c95-b2fd-d459c37ccfba
		sourceColumn: last_refresh_status

	/// Whether the item is assigned to a domain.
	column 'Assigned to Domain'
		dataType: string
		lineageTag: 599f0485-d877-44ca-a173-5c5a8035f339
		sourceColumn: assigned_to_domain

	/// Whether the item is assigned to a capacity.
	column 'Assigned to Capacity'
		dataType: string
		lineageTag: a4edb459-1f02-46c7-93c4-2eb06ddb60bf
		sourceColumn: assigned_to_capacity

	/// Sensitivity label identifier.
	column 'Sensitivity Label ID'
		dataType: string
		isHidden
		lineageTag: 23ccfb31-619b-478a-abac-da3c7fb90cdc
		summarizeBy: none
		sourceColumn: sensitivity_label_id

	/// Assigned domain identifier.
	column 'Domain ID'
		dataType: string
		isHidden
		lineageTag: c674ea25-d677-4e1f-b883-17c74ac4aec7
		summarizeBy: none
		sourceColumn: domain_id

	/// Link to the governed item.
	column 'Item URL'
		dataType: string
		lineageTag: c9ec96b5-7e30-4932-b1fc-c6c346f1157f
		dataCategory: WebUrl
		sourceColumn: url

	/// Whether the row remains in the current managed snapshot.
	column 'Current Item'
		dataType: boolean
		isHidden
		lineageTag: e04e4282-8648-44a3-ba6a-9180552d2f69
		sourceColumn: _is_current

	partition 'Governance Items' = entity
		mode: directLake
		source
			entityName: onelake_catalog_governance_for_admins__fabric_items
			schemaName: admin_monitoring
			expressionSource: 'DirectLake - Admin Monitoring Historical Analytics'
