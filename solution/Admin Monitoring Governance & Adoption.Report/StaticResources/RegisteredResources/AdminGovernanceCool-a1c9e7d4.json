{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.153.json",
  "name": "AdminGovernanceCool-a1c9e7d4.json",
  "dataColors": [
    "#0078D4",
    "#00A4EF",
    "#5C2D91",
    "#008272",
    "#FFB900",
    "#D13438",
    "#107C10",
    "#52606D"
  ],
  "good": "#107C10",
  "neutral": "#FFB900",
  "bad": "#D13438",
  "maximum": "#0078D4",
  "center": "#FFB900",
  "minimum": "#DCEEFF",
  "null": "#94A3B8",
  "foreground": "#243447",
  "foregroundNeutralSecondary": "#52606D",
  "background": "#FFFFFF",
  "backgroundNeutral": "#F1F5F9",
  "tableAccent": "#0078D4",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#243447"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#243447"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#243447"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#243447"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCE3EA"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#243447"
              }
            }
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "bold": true,
            "$id": "default"
          }
        ],
        "label": [
          {
            "show": true,
            "$id": "default"
          }
        ],
        "cardCalloutArea": [
          {
            "paddingUniform": 0
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit",
            "backColor": {
              "solid": {
                "color": "#E8F1FB"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#243447"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#243447"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#243447"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontFamily": "Segoe UI Semibold",
            "textSize": 10,
            "fontColor": {
              "solid": {
                "color": "#243447"
              }
            },
            "outlineStyle": 0
          }
        ],
        "items": [
          {
            "fontFamily": "Segoe UI",
            "textSize": 9,
            "fontColor": {
              "solid": {
                "color": "#243447"
              }
            },
            "outlineStyle": 0,
            "padding": 2
          }
        ]
      }
    }
  }
}
